PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Bỏ trống thì chế độ file tự sinh secret và lưu trong file dữ liệu; chế độ mysql bắt buộc >= 32 ký tự
JWT_SECRET=

# file (mặc định, không cần MySQL; dữ liệu ở server/data/db.json, tạo từ src/seed.js) hoặc mysql
DB_DRIVER=file
# DATA_FILE=./data/db.json

# Chỉ dùng khi DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=life_world
